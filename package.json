{
  "name": "@joshghent/uptime",
  "version": "1.3.0",
  "description": "Open source status page that runs on Cloudflare Workers + D1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshghent/uptime.git"
  },
  "homepage": "https://github.com/joshghent/uptime#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "uptime": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "node scripts/build.ts",
    "setup": "node scripts/ensure-config.ts",
    "dev": "node scripts/ensure-config.ts && wrangler dev",
    "deploy": "node scripts/ensure-config.ts && npm run db:migrate && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck && npm run lint:config",
    "lint:config": "node scripts/ensure-config.ts && node src/cli.ts lint",
    "test": "node scripts/ensure-config.ts && vitest run",
    "test:watch": "vitest",
    "db:create": "wrangler d1 create uptime",
    "db:migrate": "wrangler d1 migrations apply uptime --remote",
    "db:migrate:local": "wrangler d1 migrations apply uptime --local",
    "cf-typegen": "wrangler types",
    "prepack": "node scripts/build.ts"
  },
  "dependencies": {
    "wrangler": "^4.119.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "hono": "^4.13.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
