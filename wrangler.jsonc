// For working on the package: `pnpm dev` and the tests run dev/worker.ts
// against a local database. Nothing deploys from this repository — a real
// status page is a copy of template/, whose wrangler.jsonc has the advice on
// domains and databases.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uptime",
  "main": "dev/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // status.yaml, the CSS, llms.txt and the migrations are imported as text.
  // The published package inlines them at build time instead.
  "rules": [{ "type": "Text", "globs": ["**/*.yaml", "**/*.css", "**/*.txt", "**/*.sql"], "fallthrough": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uptime",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],

  "triggers": {
    "crons": ["* * * * *"]
  }
}
