{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uptime",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // A status page belongs on a domain the apps it watches don't serve, so an
  // outage there cannot take the page with it. `custom_domain` makes wrangler
  // create the DNS record on deploy; the zone has to already be in the account.
  "routes": [{ "pattern": "status.turbotechnologies.co.uk", "custom_domain": true }],

  // Kept on so the workers.dev URL stays a working fallback if DNS or the
  // certificate ever has a bad day.
  "workers_dev": true,

  // status.yaml is bundled into the Worker as a string at build time. The
  // config lives in git, not in a database — editing it means a deploy, which
  // is the whole point. The CSS is inlined into the page for the same reason:
  // one request, no asset pipeline.
  "rules": [{ "type": "Text", "globs": ["**/*.yaml", "**/*.css", "**/*.txt"], "fallthrough": true }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uptime",
      "database_id": "9e65ec91-1221-4208-a292-28d48027148d",
      "migrations_dir": "migrations"
    }
  ],

  // The cron fires every minute; each monitor is skipped unless its own
  // `interval` has elapsed. Lower the frequency here if you want fewer D1
  // writes than your monitors' intervals imply.
  "triggers": {
    "crons": ["* * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
